# Supabase (local Docker)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=<from docker .env>
SUPABASE_SERVICE_ROLE_KEY=<from docker .env>
SUPABASE_JWT_SECRET=<from docker .env>

# OpenAI (used for embeddings)
OPENAI_API_KEY=sk-...

# OpenRouter (optional — if not set, falls back to OpenAI direct)
OPENROUTER_API_KEY=
LLM_MODEL=gpt-4.1

# LangSmith (optional initially — set up at https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-masterclass

# App
BACKEND_CORS_ORIGINS=http://localhost:5173
